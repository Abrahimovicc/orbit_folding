include README.md LICENSE CITATION.cff THIRD_PARTY_NOTICES.md pyproject.toml
recursive-include configs *.yaml
recursive-include docs *.md *.json
recursive-include licenses *.txt
recursive-include data *.json *.md *.txt *.ply
recursive-include assets *.gif *.png *.json *.jsonl *.md *.txt
recursive-include tools *.py
recursive-include applications *.py *.md
recursive-include tests *.py
prune data/samples/processed
prune outputs
global-exclude __pycache__ *.py[cod]
